<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
</head>
<body>
    <h3>Create a new Chat</h3>
    <form method="post" action="/chats">
        <input type="text" placeholder="Sender's name" name="Sender"><br><br>
        <textarea name="msg" placeholder="Write your message here..."></textarea><br><br>
        <input type="text" name="Receiver" placeholder="Receiver's name"><br><br>
        <button>Create Chat</button>
    </form>
</body>
</html>