<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChitChat</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3>Chats</h3>
    <form method="get" action="/chats/new">
        <button id="newChat">New Chat</button>
    </form><br><br>
    <% for (let chat of chats) { %>
        <div class="chatbox">
            <p>From: <i><%= chat.sender %></i></p>
            <div class="msg">
                <p><%= chat.message %></p>
                <form action="/chats/<%= chat._id %>/edit" method="get">
                    <button>Edit Chat</button>
                </form>
                <br>
                <form method="post" action="/chats/<%= chat._id %>?_method=DELETE">
                    <button>Delete Chat</button>
                </form>
                <br>
                <form method="get" action="/chats/<%= chat._id %>">
                    <button>Show</button>
                </form>
            </div>
            <p>To: <i><%= chat.receiver %></i></p>
            <hr>
            <p><%= chat.created_at.toString().split(" ")[4] %> </p>
            <p><%= chat.created_at.toString().split(" ").slice(0,4).join("-") %> </p>
        </div>
        <br><br>
    <% } %>
</body>
</html>